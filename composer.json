{
    "name": "morphp/medas-entity-manager",
    "description": "Medas entity manager",
    "authors": [
        {
            "name": "Patrick Morpey",
            "email": "patrick@morphp.nl"
        }
    ],
    "type": "library",
    "require": {
        "morphp/medas-core": "@dev",
        "morphp/medas-service-manager": "@dev",
        "morphp/medas-env-manager": "@dev",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../service-manager"
        },
        {
            "type": "path",
            "url": "../env-manager"
        }
    ],
    "autoload": {
        "psr-4": {
            "Medas\\EntityManager\\": "src/",
            "Medas\\Test\\": "tests/"
        }
    }
}
