{
  "name": "morphp/medas-entity-manager",
  "description": "Medas entity manager",
  "keywords": [
    "entities"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "ext-pdo": "*",
    "morphp/medas-core": "^4.3",
    "morphp/medas-json": "^3",
    "morphp/medas-object-to-array-serializer": "^3",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-config-manager": "^3",
    "morphp/medas-config-options": "^3",
    "morphp/medas-events": "^3",
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\EntityManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\EntityManagerTest\\": "tests/"
    }
  }
}
