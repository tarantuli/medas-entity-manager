{
    "name": "morphp/medas-entity-manager",
    "description": "Medas entity manager",
    "authors": [
        {
            "name": "Patrick Morpey",
            "email": "patrick@morphp.nl"
        }
    ],
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "morphp/medas-service-manager": "@dev",
        "morphp/medas-config-manager": "@dev",
        "morphp/medas-file-builder": "@dev",
        "ext-pdo": "*",
        "symfony/cache": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../service-manager"
        },
        {
            "type": "path",
            "url": "../config-manager"
        },
        {
            "type": "path",
            "url": "../file-builder"
        },
        {
            "type": "path",
            "url": "../php-reformatter"
        },
        {
            "type": "path",
            "url": "../filesystem"
        }
    ],
    "autoload": {
        "psr-4": {
            "Medas\\EntityManager\\": "src/",
            "Medas\\Test\\": "tests/"
        }
    }
}
