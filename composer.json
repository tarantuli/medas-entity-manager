{
    "name": "morphp/medas-entity-manager",
    "description": "Medas entity manager",
    "keywords": [
        "entities"
    ],
    "authors": [
        {
            "name": "Patrick Morpey",
            "email": "patrick@morphp.nl"
        }
    ],
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "ext-pdo": "*",
        "morphp/medas-console": "dev-dev",
        "morphp/medas-core": "dev-dev",
        "morphp/medas-service-manager": "dev-dev"
    },
    "require-dev": {
        "morphp/medas-config-manager": "dev-dev",
        "morphp/medas-config-options": "dev-dev",
        "morphp/medas-events": "dev-dev",
        "morphp/medas-file-system": "dev-dev",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Medas\\EntityManager\\": "src/",
            "Medas\\EntityManagerTest\\": "tests/"
        }
    }
}
